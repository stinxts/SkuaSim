<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VibeSkuaDir Condition="'$(VibeSkuaDir)' == ''">$(LOCALAPPDATA)\VibeSkua\current\Assemblies</VibeSkuaDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkuaSim.Collector\SkuaSim.Collector.csproj" />
    <Reference Include="Skua.Core">
      <HintPath>$(VibeSkuaDir)\Skua.Core.dll</HintPath>
    </Reference>
    <Reference Include="Skua.Core.Interfaces">
      <HintPath>$(VibeSkuaDir)\Skua.Core.Interfaces.dll</HintPath>
    </Reference>
    <Reference Include="Skua.Core.Models">
      <HintPath>$(VibeSkuaDir)\Skua.Core.Models.dll</HintPath>
    </Reference>
    <Reference Include="Skua.Core.Utils">
      <HintPath>$(VibeSkuaDir)\Skua.Core.Utils.dll</HintPath>
    </Reference>
    <Reference Include="CommunityToolkit.Mvvm">
      <HintPath>$(VibeSkuaDir)\CommunityToolkit.Mvvm.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VibeSkuaDir)\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
