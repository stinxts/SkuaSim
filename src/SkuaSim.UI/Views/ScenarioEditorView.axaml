<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SkuaSim.UI.ViewModels"
             xmlns:models="using:SkuaSim.UI.Models"
             x:Class="SkuaSim.UI.Views.ScenarioEditorView"
             x:DataType="vm:ScenarioEditorViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <!-- Editor Action Bar -->
        <Border Grid.Row="0" Classes="SubCard" Padding="8,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Scenario Editor:" Classes="MetricLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EditorStatusText}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                    <TextBlock Text="(Edits apply immediately on Run)" Classes="MetricLabel" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="Lv 1 Starter" Command="{Binding NewStarterTemplateCommand}" Padding="10,4" FontSize="11" />
                <Button Grid.Column="2" Content="Lv 100 Endgame" Command="{Binding NewEndgameTemplateCommand}" Padding="10,4" FontSize="11" />
                <Button Grid.Column="3" Classes="Primary" Content="Save" Command="{Binding SaveScenarioCommand}" Padding="12,4" FontSize="11" />
                <Button Grid.Column="4" Content="Save As..." Command="{Binding SaveScenarioAsCommand}" Padding="10,4" FontSize="11" />
            </Grid>
        </Border>

        <!-- Main Split: Left = Scenario & Gear Form, Right = Discovered Script Options -->
        <Grid Grid.Row="1" ColumnDefinitions="*,440" ColumnSpacing="10">
            <!-- Left Column: Scrollable Scenario Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Margin="0,0,6,0">
                    <!-- General & Player -->
                    <Border Classes="Card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Player &amp; Starting State" Classes="SectionTitle" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Scenario Name" Classes="MetricLabel" />
                                    <TextBox Text="{Binding ScenarioName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Username" Classes="MetricLabel" />
                                    <TextBox Text="{Binding Username}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Class" Classes="MetricLabel" />
                                    <TextBox Text="{Binding ClassName}" PlaceholderText="e.g. Mage, ArchPaladin" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Level (1-100)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding LevelText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Class Rank" Classes="MetricLabel" />
                                    <TextBox Text="{Binding ClassRankText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Gold" Classes="MetricLabel" />
                                    <TextBox Text="{Binding GoldText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock Text="ACs" Classes="MetricLabel" />
                                    <TextBox Text="{Binding CoinsText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="2">
                                    <TextBlock Text="Inv Slots" Classes="MetricLabel" />
                                    <TextBox Text="{Binding InventorySlotsText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Spacing="2">
                                    <TextBlock Text="Bank Slots" Classes="MetricLabel" />
                                    <TextBox Text="{Binding BankSlotsText}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <CheckBox Content="Member (Upgrade)" IsChecked="{Binding IsMember}" />
                                <CheckBox Content="Invulnerable (God Mode)" IsChecked="{Binding Invulnerable}" />
                            </StackPanel>

                            <!-- Optional Manual Overrides (blank = AQW StatEngine) -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="MaxHP Override (blank = AQW Auto)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding MaxHealthOverrideText}" PlaceholderText="Auto from StatEngine" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="DPS Override (blank = AQW Auto)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding DpsOverrideText}" PlaceholderText="Auto from StatEngine" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Regen %/s Override (blank = Auto)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding RegenOverrideText}" PlaceholderText="Auto class heal" />
                                </StackPanel>
                            </Grid>

                            <!-- Location & Limits -->
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Start Map" Classes="MetricLabel" />
                                    <TextBox Text="{Binding StartMap}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Cell" Classes="MetricLabel" />
                                    <TextBox Text="{Binding StartCell}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Pad" Classes="MetricLabel" />
                                    <TextBox Text="{Binding StartPad}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock Text="Max Virt (m)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding MaxVirtualMinutesText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="2">
                                    <TextBlock Text="Max Real (s)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding MaxRealSecondsText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Spacing="2">
                                    <TextBlock Text="Stall (s)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding StallRealSecondsText}" />
                                </StackPanel>
                            </Grid>

                            <!-- Quests -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Completed Quest IDs (comma-separated)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding CompletedQuestsText}" PlaceholderText="e.g. 2937, 8738" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Active Quest IDs (comma-separated)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding ActiveQuestsText}" PlaceholderText="e.g. 4007" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Inventory & Equipment -->
                    <Border Classes="Card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Starting Inventory &amp; Enhancements" Classes="SectionTitle" />
                            <Grid ColumnDefinitions="*,100,56,66,56,56,56,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Text="{Binding NewInvName}" PlaceholderText="Item name..." />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CommonCategories}" SelectedItem="{Binding NewInvCategory}" HorizontalAlignment="Stretch" />
                                <TextBox Grid.Column="2" Text="{Binding NewInvQuantityText}" ToolTip.Tip="Quantity" />
                                <CheckBox Grid.Column="3" Content="Eq" IsChecked="{Binding NewInvEquipped}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="4" Text="{Binding NewInvEnhPatText}" ToolTip.Tip="EnhPatternID (2=Ftr,3=Thf,6=Wiz,9=Luck)" />
                                <TextBox Grid.Column="5" Text="{Binding NewInvEnhLvlText}" ToolTip.Tip="EnhLevel (0=Unenhanced)" />
                                <TextBox Grid.Column="6" Text="{Binding NewInvProcIdText}" ToolTip.Tip="Weapon ProcID (2=SC,3=AB,9=Val,14=Daunt)" />
                                <Button Grid.Column="7" Content="Add" Command="{Binding AddInventoryItemCommand}" Padding="10,4" />
                            </Grid>
                            <TextBlock Text="Columns: Name | Category | Qty | Equipped | EnhPatternID | EnhLevel | ProcID" Classes="MetricLabel" FontSize="10" />

                            <ItemsControl ItemsSource="{Binding InventoryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ScenarioItemEditorRow">
                                        <Border Classes="SubCard" Margin="0,2" Padding="6,4">
                                            <Grid ColumnDefinitions="*,90,52,Auto,58,58,58,Auto" ColumnSpacing="6">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" />
                                                <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='x{0}'}" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="11" />
                                                <TextBlock Grid.Column="3" Text="EQ" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" IsVisible="{Binding Equipped}" Margin="4,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding EnhancementPatternID, StringFormat='Pat:{0}'}" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="10" Foreground="#38BDF8" />
                                                <TextBlock Grid.Column="5" Text="{Binding EnhancementLevel, StringFormat='Lv:{0}'}" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="10" Foreground="#38BDF8" />
                                                <TextBlock Grid.Column="6" Text="{Binding ProcID, StringFormat='Pr:{0}'}" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="10" Foreground="#F59E0B" />
                                                <Button Grid.Column="7"
                                                        Content="✕"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        Command="{Binding $parent[UserControl].((vm:ScenarioEditorViewModel)DataContext).RemoveInventoryItemCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Bank -->
                    <Border Classes="Card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Starting Bank Items" Classes="SectionTitle" />
                            <Grid ColumnDefinitions="*,80,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Text="{Binding NewBankName}" PlaceholderText="Bank item name..." />
                                <TextBox Grid.Column="1" Text="{Binding NewBankQuantityText}" />
                                <Button Grid.Column="2" Content="Add" Command="{Binding AddBankItemCommand}" Padding="10,4" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding BankItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ScenarioItemEditorRow">
                                        <Border Classes="SubCard" Margin="0,2" Padding="6,4">
                                            <Grid ColumnDefinitions="*,70,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="11" />
                                                <Button Grid.Column="2"
                                                        Content="✕"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        Command="{Binding $parent[UserControl].((vm:ScenarioEditorViewModel)DataContext).RemoveBankItemCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Script Options (Bot.Config) Inspector & Editor -->
            <Border Grid.Column="1" Classes="Card">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="Script Options (Bot.Config)" Classes="SectionTitle" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="Primary"
                                Content="Inspect Script Options"
                                Command="{Binding InspectScriptOptionsCommand}"
                                IsEnabled="{Binding !IsInspectingOptions}"
                                Padding="10,4"
                                FontSize="11" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ScriptOptionsSummary}"
                               Classes="MetricLabel"
                               TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScriptOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ScriptOptionEditorRow">
                                    <Border Classes="SubCard" Margin="0,0,0,6">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding ValueType}" Classes="MetricLabel" FontSize="10" />
                                            </Grid>
                                            <TextBlock Text="{Binding Description}"
                                                       Classes="MetricLabel"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}" />
                                            <ComboBox ItemsSource="{Binding AllowedValues}"
                                                      SelectedItem="{Binding SelectedChoice}"
                                                      HorizontalAlignment="Stretch"
                                                      IsVisible="{Binding IsChoice}" />
                                            <TextBox Text="{Binding TextValue}" IsVisible="{Binding IsText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
