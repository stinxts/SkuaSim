<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SkuaSim.UI.ViewModels"
             xmlns:models="using:SkuaSim.UI.Models"
             xmlns:scenarios="using:SkuaSim.Core.Scenarios"
             x:Class="SkuaSim.UI.Views.ScenarioEditorView"
             x:DataType="vm:ScenarioEditorViewModel">

    <UserControl.Resources>
        <!-- Skua-faithful Script Option row template (shared by single-list and multi-category TabControl modes) -->
        <DataTemplate x:Key="SkuaOptionRowTemplate" x:DataType="models:ScriptOptionEditorRow">
            <Panel Margin="0,0,0,6">
                <!-- Skua whitespace explanation / section header option: Option<string>(" ", "Title", "Desc") -->
                <Border Background="#131E30"
                        BorderBrush="#2563EB"
                        BorderThickness="3,0,0,0"
                        CornerRadius="3"
                        Padding="8,6"
                        IsVisible="{Binding IsHeader}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding DisplayName}"
                                   Classes="MetricValue"
                                   Foreground="#93C5FD"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}"
                                   Classes="MetricLabel"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- Standard Skua Option row: DisplayName + Description on left, CheckBox / ComboBox / TextBox on right -->
                <Border Classes="SubCard"
                        Padding="10,7"
                        IsVisible="{Binding IsEditable}"
                        ToolTip.Tip="{Binding Description}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       Classes="MetricValue"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}"
                                       Classes="MetricLabel"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <Panel Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding BoolValue}"
                                      IsVisible="{Binding IsBool}"
                                      HorizontalAlignment="Right"
                                      MinWidth="0" />
                            <ComboBox ItemsSource="{Binding AllowedValues}"
                                      SelectedItem="{Binding SelectedChoice}"
                                      Width="156"
                                      IsVisible="{Binding IsChoice}" />
                            <TextBox Text="{Binding TextValue}"
                                     Width="156"
                                     IsVisible="{Binding IsText}" />
                        </Panel>
                    </Grid>
                </Border>
            </Panel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <!-- Editor Action Bar -->
        <Border Grid.Row="0" Classes="SubCard" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Scenario Editor:" Classes="MetricLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EditorStatusText}" Classes="BodyText" Foreground="#38BDF8" VerticalAlignment="Center" />
                    <TextBlock Text="(Edits apply immediately on Run)" Classes="MetricLabel" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="Lv 1 Starter" Command="{Binding NewStarterTemplateCommand}" />
                <Button Grid.Column="2" Content="Lv 100 Endgame" Command="{Binding NewEndgameTemplateCommand}" />
                <Button Grid.Column="3" Classes="Primary" Content="Save" Command="{Binding SaveScenarioCommand}" />
                <Button Grid.Column="4" Content="Save As..." Command="{Binding SaveScenarioAsCommand}" />
            </Grid>
        </Border>

        <!-- Main Proportional Split: Left = Scenario / Boosts / Enhancements, Right = Skua Script Options -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.60*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="0.40*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Scrollable Scenario Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                <StackPanel Spacing="10" Margin="0,0,8,0">

                    <!-- 1. Player, Databank Class & Live Real Stats Preview -->
                    <Border Classes="Card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Player, Databank Class &amp; Limits" Classes="SectionTitle" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{Binding ClassSourceBadgeBackground}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="{Binding ClassSourceBadge}" Classes="BadgeText" Foreground="#F8FAFC" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Scenario Name" Classes="MetricLabel" />
                                    <TextBox Text="{Binding ScenarioName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Username" Classes="MetricLabel" />
                                    <TextBox Text="{Binding Username}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="Known Class (from Databank)" Classes="MetricLabel" />
                                    <ComboBox ItemsSource="{Binding KnownClasses}"
                                              SelectedItem="{Binding SelectedKnownClass}"
                                              PlaceholderText="Select databank class..."
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ClassCatalogOption">
                                                <TextBlock Text="{Binding DisplayName}" Classes="BodyText" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="1.5*,*,*,*,*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Class Name (or custom)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding ClassName}" PlaceholderText="e.g. Void Highlord" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Level (1-100)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding LevelText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="Class Rank" Classes="MetricLabel" />
                                    <TextBox Text="{Binding ClassRankText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Text="Gold" Classes="MetricLabel" />
                                    <TextBox Text="{Binding GoldText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="3">
                                    <TextBlock Text="ACs" Classes="MetricLabel" />
                                    <TextBox Text="{Binding CoinsText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Spacing="3">
                                    <TextBlock Text="Inv / Bank" Classes="MetricLabel" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                        <TextBox Grid.Column="0" Text="{Binding InventorySlotsText}" ToolTip.Tip="Inventory slots" />
                                        <TextBox Grid.Column="1" Text="{Binding BankSlotsText}" ToolTip.Tip="Bank slots" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Live Real Stats Preview Box -->
                            <Border Classes="SubCard" Padding="10,6">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding StatsPreviewLine1}" Classes="MonoText" Foreground="#4ADE80" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatsPreviewLine2}" Classes="MonoText" Foreground="#38BDF8" TextWrapping="Wrap" IsVisible="{Binding StatsPreviewLine2, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Border>

                            <CheckBox Content="Member (Upgrade)" IsChecked="{Binding IsMember}" />

                            <!-- Location & Simulation Duration / Limits -->
                            <Grid ColumnDefinitions="*,*,*,1.5*,*,*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Start Map" Classes="MetricLabel" />
                                    <TextBox Text="{Binding StartMap}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Cell" Classes="MetricLabel" />
                                    <TextBox Text="{Binding StartCell}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="Pad" Classes="MetricLabel" />
                                    <TextBox Text="{Binding StartPad}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Text="Virtual Duration" Classes="MetricLabel" />
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="4">
                                        <TextBox Grid.Column="0" Text="{Binding VirtualDurationAmountText}" IsEnabled="{Binding IsVirtualDurationAmountEnabled}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DurationUnitOptions}" SelectedItem="{Binding VirtualDurationUnit}" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="3">
                                    <TextBlock Text="Max Real (s, 0=∞)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding MaxRealSecondsText}"
                                             PlaceholderText="0 (Infinite)"
                                             ToolTip.Tip="Maximum wall-clock execution seconds (0 or blank = Infinite / Unlimited)" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Spacing="3">
                                    <TextBlock Text="Stall (s)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding StallRealSecondsText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6" Spacing="3">
                                    <TextBlock Text="No Progress (min)" Classes="MetricLabel" />
                                    <TextBox Text="{Binding MaxNoProgressMinutesText}"
                                             PlaceholderText="60"
                                             ToolTip.Tip="Stop as 'Stalled' when level, XP, gold, items, quests and reputation stay unchanged for this many virtual minutes (likely an infinite loop). 0 = disabled." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Active Boosts & Real AQW Boosted Equipment -->
                    <Border Classes="Card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="Boosts &amp; Real AQW Boosted Equipment" Classes="SectionTitle" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Endgame Meta" Command="{Binding ApplyEndgameGearBoostsCommand}" />
                                <Button Grid.Column="2" Content="Clear Gear" Command="{Binding ClearGearBoostsCommand}" />
                            </Grid>

                            <Border Classes="SubCard">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Consumable / Server Boosts (2x Multipliers)" Classes="MetricLabel" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="6">
                                        <CheckBox Content="2x XP Boost" IsChecked="{Binding XpBoost}" />
                                        <CheckBox Content="2x Class Points (CP)" IsChecked="{Binding ClassPointsBoost}" />
                                        <CheckBox Content="2x Gold Boost" IsChecked="{Binding GoldBoost}" />
                                        <CheckBox Content="2x Reputation (Rep)" IsChecked="{Binding RepBoost}" />
                                        <CheckBox Content="2x Server Boost (All)" IsChecked="{Binding ServerBoost}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="SubCard">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Equipped AQW Boosted Gear (multi-boost items supported; AQW highest-in-category stacking rules)" Classes="MetricLabel" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding EquipmentBoosts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:GearSlotBoostEditorRow">
                                                <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Margin="0,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding Slot}" Classes="MetricValue" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding AvailableItems}"
                                                              SelectedItem="{Binding SelectedItem}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="scenarios:AqwBoostItemInfo">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="BodyText" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="MetricLabel" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. Awe & Forge Enhancements Unlocked Checklists -->
                    <Border Classes="Card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Unlocked Enhancements (Auto-Unlocks AQW Quests &amp; Loadout)" Classes="SectionTitle" />

                            <!-- Awe Enhancements -->
                            <Border Classes="SubCard">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Awe Enhancements (Quest #2937)" Classes="MetricValue" Foreground="#F59E0B" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Content="Select All Awe" IsChecked="{Binding AllAweSelected}" FontWeight="SemiBold" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding AweEnhancements}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:EnhancementCheckItem">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Forge Enhancements with Master All + Per-Category Weapon/Helm/Cape All -->
                            <Border Classes="SubCard">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Forge Enhancements (Weapon / Helm / Cape)" Classes="MetricValue" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Content="Select All Forge" IsChecked="{Binding AllForgeSelected}" FontWeight="SemiBold" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                        <!-- Forge Weapon -->
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <CheckBox Content="All Weapon"
                                                      IsChecked="{Binding AllForgeWeaponSelected}"
                                                      FontWeight="SemiBold"
                                                      Foreground="#93C5FD" />
                                            <Border Height="1" Background="#222D3C" Margin="0,1,0,3" />
                                            <ItemsControl ItemsSource="{Binding ForgeWeaponEnhancements}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:EnhancementCheckItem">
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Forge Helm -->
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <CheckBox Content="All Helm"
                                                      IsChecked="{Binding AllForgeHelmSelected}"
                                                      FontWeight="SemiBold"
                                                      Foreground="#93C5FD" />
                                            <Border Height="1" Background="#222D3C" Margin="0,1,0,3" />
                                            <ItemsControl ItemsSource="{Binding ForgeHelmEnhancements}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:EnhancementCheckItem">
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Forge Cape -->
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <CheckBox Content="All Cape"
                                                      IsChecked="{Binding AllForgeCapeSelected}"
                                                      FontWeight="SemiBold"
                                                      Foreground="#93C5FD" />
                                            <Border Height="1" Background="#222D3C" Margin="0,1,0,3" />
                                            <ItemsControl ItemsSource="{Binding ForgeCapeEnhancements}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:EnhancementCheckItem">
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          MinWidth="6"
                          Margin="1,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <!-- Right Column: Skua-Faithful Script Options (Bot.Config) -->
            <Border Grid.Column="2" Classes="Card" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="Script Options" Classes="SectionTitle" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Load Skua .cfg"
                                Command="{Binding LoadSavedSkuaOptionsCommand}"
                                IsVisible="{Binding HasSavedSkuaCfg}"
                                ToolTip.Tip="Import your saved values from Skua's options/&lt;OptionsStorage&gt;.cfg" />
                        <Button Grid.Column="2"
                                Content="Reset Defaults"
                                Command="{Binding ResetScriptOptionsToDefaultsCommand}"
                                IsEnabled="{Binding HasAnyScriptOptions}"
                                ToolTip.Tip="Reset all script options back to their script default values" />
                        <Button Grid.Column="3"
                                Classes="Primary"
                                Content="Inspect Script"
                                Command="{Binding InspectScriptOptionsCommand}"
                                IsEnabled="{Binding !IsInspectingOptions}" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ScriptOptionsSummary}"
                               Classes="MetricLabel"
                               TextWrapping="Wrap" />

                    <Panel Grid.Row="2">
                        <!-- Single-category Script Options (e.g. standard Options list) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding !HasMultipleOptionCategories}">
                            <ItemsControl ItemsSource="{Binding ScriptOptions}"
                                          ItemTemplate="{StaticResource SkuaOptionRowTemplate}" />
                        </ScrollViewer>

                        <!-- Multi-category Script Options (Skua MultiOptions tabs, e.g. Generic / Select or Weapon / Helm / Cape) -->
                        <TabControl ItemsSource="{Binding ScriptOptionCategories}"
                                    IsVisible="{Binding HasMultipleOptionCategories}">
                            <TabControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ScriptOptionCategoryGroup">
                                    <TextBlock Text="{Binding HeaderText}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate x:DataType="models:ScriptOptionCategoryGroup">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding Options}"
                                                      ItemTemplate="{StaticResource SkuaOptionRowTemplate}" />
                                    </ScrollViewer>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Panel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
