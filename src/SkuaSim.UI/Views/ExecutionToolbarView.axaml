<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SkuaSim.UI.ViewModels"
             xmlns:models="using:SkuaSim.UI.Models"
             x:Class="SkuaSim.UI.Views.ExecutionToolbarView"
             x:DataType="vm:MainViewModel">

    <Border Classes="Card">
        <StackPanel Spacing="8">
            <!-- Warning banner when Skua/VibeSkua is not auto-detected -->
            <Border Classes="WarningCard" IsVisible="{Binding !IsSkuaConfigured}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Skua / VibeSkua Installation Required" Classes="SectionTitle" Foreground="#FBBF24" />
                        <TextBlock Text="{Binding SkuaSetupWarning}" Classes="BodyText" TextWrapping="Wrap" Foreground="#FDE68A" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Select Skua Folder..." Command="{Binding BrowseSkuaFolderCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Row 1: Script selection, quick filter, Display Resolution/Scale, and workspace tools -->
            <Grid ColumnDefinitions="Auto,*,Auto,230,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Script (.cs):" VerticalAlignment="Center" Classes="MetricLabel" />
                <TextBox Grid.Column="1"
                         Text="{Binding ScriptPathText}"
                         PlaceholderText="Path to any Skua .cs script..."
                         VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseScriptCommand}" />

                <Grid Grid.Column="3" ColumnDefinitions="*,*" ColumnSpacing="4">
                    <TextBox Grid.Column="0"
                             Text="{Binding ScriptSearchText}"
                             PlaceholderText="Filter..." />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding FilteredScripts}"
                              SelectedItem="{Binding SelectedScript}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Scripts\...">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ScriptEntry">
                                <TextBlock Text="{Binding DisplayName}" Classes="BodyText" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <TextBlock Grid.Column="4" Text="Display:" VerticalAlignment="Center" Classes="MetricLabel" Margin="4,0,0,0" />
                <ComboBox Grid.Column="5"
                          Width="136"
                          ItemsSource="{Binding DisplayScalePresets}"
                          SelectedItem="{Binding SelectedDisplayScale}"
                          ToolTip.Tip="Adaptive UI scaling preset for HD, Full-HD, 2K, 4K, and 8K displays">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DisplayScalePreset">
                            <TextBlock Text="{Binding Label}" Classes="BodyText" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="6" Content="Refresh" Command="{Binding RefreshWorkspaceCommand}" ToolTip.Tip="Rescan Scripts\, scenarios\, and databank classes" />
                <Button Grid.Column="7" Content="Skua Dir..." Command="{Binding BrowseSkuaFolderCommand}" ToolTip.Tip="{Binding ClientFlavorText}" />
            </Grid>

            <!-- Row 2: Scenario, Seed, Virtual Duration, Speed, and Execution Buttons -->
            <Grid ColumnDefinitions="Auto,190,*,Auto,Auto,Auto,Auto,Auto,Auto,126,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="Scenario:" VerticalAlignment="Center" Classes="MetricLabel" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableScenarios}"
                          SelectedItem="{Binding SelectedScenario}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ScenarioEntry">
                            <TextBlock Text="{Binding DisplayName}" Classes="BodyText" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Column="2"
                         Text="{Binding ScenarioPathText}"
                         PlaceholderText="(optional scenario .json path)"
                         VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Browse..." Command="{Binding BrowseScenarioCommand}" />

                <TextBlock Grid.Column="4" Text="Seed:" VerticalAlignment="Center" Classes="MetricLabel" Margin="4,0,0,0" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBox Width="96" Text="{Binding SeedText}" PlaceholderText="42"
                             HorizontalContentAlignment="Center" VerticalAlignment="Center"
                             ToolTip.Tip="Same seed = the same run. Change it only to try another luck on random rolls (e.g. a 1 % drop)." />
                    <Button Content="Random" Command="{Binding RandomSeedCommand}" Padding="8,5"
                            ToolTip.Tip="Put a new random seed in the box (once). It stays until you change it, so the run can be repeated." />
                </StackPanel>

                <TextBlock Grid.Column="6" Text="Virtual Limit:" VerticalAlignment="Center" Classes="MetricLabel" Margin="4,0,0,0" />
                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ComboBox Width="134"
                              ItemsSource="{Binding VirtualDurationPresets}"
                              SelectedItem="{Binding SelectedVirtualDuration}"
                              ToolTip.Tip="Maximum virtual time for long scripts (minutes, hours, days, weeks, or Unlimited)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:VirtualDurationPreset">
                                <TextBlock Text="{Binding Label}" Classes="BodyText" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Width="58"
                             Text="{Binding CustomVirtualAmountText}"
                             HorizontalContentAlignment="Center"
                             IsVisible="{Binding IsCustomVirtualDuration}"
                             ToolTip.Tip="Custom virtual duration value (0 = Unlimited)" />
                    <ComboBox Width="92"
                              ItemsSource="{Binding CustomDurationUnits}"
                              SelectedItem="{Binding CustomVirtualUnit}"
                              IsVisible="{Binding IsCustomVirtualDuration}" />
                </StackPanel>

                <TextBlock Grid.Column="8" Text="Speed:" VerticalAlignment="Center" Classes="MetricLabel" Margin="4,0,0,0" />
                <ComboBox Grid.Column="9"
                          ItemsSource="{Binding SpeedPresets}"
                          SelectedItem="{Binding SelectedSpeed}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SpeedPreset">
                            <TextBlock Text="{Binding Label}" Classes="BodyText" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="10" Content="Compile" Command="{Binding CompileCommand}" Padding="12,5" />
                <Button Grid.Column="11" Classes="Primary" Content="Run" Command="{Binding RunCommand}" Padding="16,5" />
                <Button Grid.Column="12" Content="{Binding PauseResumeLabel}" Command="{Binding PauseResumeCommand}" Padding="12,5" />
                <Button Grid.Column="13" Classes="Danger" Content="Stop" Command="{Binding StopCommand}" Padding="12,5" />
            </Grid>

            <!-- Row 3: Live Telemetry Bar -->
            <Border Classes="SubCard" Padding="10,6">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Status:" Classes="MetricLabel" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Classes="MetricValue" Foreground="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="|" Classes="MetricLabel" Foreground="#334155" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ClientFlavorText}" Classes="MetricLabel" VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Virtual:" Classes="MetricLabel" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VirtualClockText}" Classes="MonoText" FontWeight="SemiBold" Foreground="#4ADE80" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Real:" Classes="MetricLabel" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RealTimeText}" Classes="MonoText" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Paused:" Classes="MetricLabel" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PausedTimeText}" Classes="MonoText" Foreground="#FBBF24" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="APIs:" Classes="MetricLabel" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ApiCallsText}" Classes="MonoText" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="Last:" Classes="MetricLabel" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LastApiCallText}" Classes="MonoText" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
