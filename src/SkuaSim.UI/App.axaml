<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkuaSim.UI.App"
             xmlns:local="using:SkuaSim.UI"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="#0F141B" />
            <Setter Property="Foreground" Value="#E6EDF3" />
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="#161E29" />
            <Setter Property="BorderBrush" Value="#263242" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.SubCard">
            <Setter Property="Background" Value="#111822" />
            <Setter Property="BorderBrush" Value="#222D3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style Selector="Border.ErrorCard">
            <Setter Property="Background" Value="#2B1418" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.WarningCard">
            <Setter Property="Background" Value="#292010" />
            <Setter Property="BorderBrush" Value="#B45309" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#93C5FD" />
        </Style>

        <Style Selector="TextBlock.MetricLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#94A3B8" />
        </Style>

        <Style Selector="TextBlock.MetricValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F1F5F9" />
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>
