<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkuaSim.Collector</AssemblyName>
    <RootNamespace>SkuaSim.Collector</RootNamespace>
    <Version>1.1.0</Version>
    <Description>Passive game data collector plugin for Skua and VibeSkua (SkuaSim).</Description>
    <VibeSkuaDir Condition="'$(VibeSkuaDir)' == ''">$(LOCALAPPDATA)\VibeSkua\current\Assemblies</VibeSkuaDir>
  </PropertyGroup>

  <!-- Release builds are shared with testers: map the local source path so the DLL does not carry this PC's user
       folder (the PDB path is written into the DLL). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/_/SkuaSim.Collector</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Skua.Core">
      <HintPath>$(VibeSkuaDir)\Skua.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.Core.Interfaces">
      <HintPath>$(VibeSkuaDir)\Skua.Core.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.Core.Models">
      <HintPath>$(VibeSkuaDir)\Skua.Core.Models.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.Core.Utils">
      <HintPath>$(VibeSkuaDir)\Skua.Core.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommunityToolkit.Mvvm">
      <HintPath>$(VibeSkuaDir)\CommunityToolkit.Mvvm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VibeSkuaDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
